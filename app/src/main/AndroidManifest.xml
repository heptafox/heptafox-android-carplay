<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Display over other apps": lets us start Spotify/YouTube while the phone is locked. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:icon="@drawable/ic_launcher"
        android:label="Hepta">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- 7 = MessageTemplate headers. Car mic (CarAudioRecord) needs 5. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />

        <!-- IOT is the closest Android Auto category; fine for a sideloaded personal app. -->
        <service
            android:name=".car.HeptaCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <activity
            android:name=".setup.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
